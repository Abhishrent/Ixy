# Discord Bot
BOT_TOKEN=your_discord_bot_token_here

# GitHub Tokens (used by cogs/gpt.py for Azure OpenAI inference)
# Add as many as you want: GITHUB_TOKEN_1, GITHUB_TOKEN_2, etc.
GITHUB_TOKEN_1=your_github_token_1_here
GITHUB_TOKEN_2=your_github_token_2_here

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google Gemini (used by cogs/feelings.py)
GEMINI_API_KEY=your_gemini_api_key_here

# Reddit API (used by cogs/fun.py)
# Create an app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# Merriam-Webster Dictionary API (used by cogs/dictionary.py)
# Get a key at https://dictionaryapi.com/
MERRIAM_WEBSTER_API_KEY=your_merriam_webster_api_key_here

# TMDB (The Movie Database) — used by cogs/tmdb.py
# Get credentials at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_API_TOKEN=your_tmdb_bearer_token_here

# Google Drive Service Account
# Place your google_drive.json file in the project root (it is gitignored)
# Get it from Google Cloud Console > IAM & Admin > Service Accounts
